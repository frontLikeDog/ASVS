{
  "name": "domain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/src",
  "projectType": "library",
  "tags": ["type:domain", "scope:shared", "runtime:universal"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/domain/src", "cwd": "{workspaceRoot}" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/domain/tsconfig.json --noEmit", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.ts --passWithNoTests libs/domain",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
