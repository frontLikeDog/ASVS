{
  "name": "render",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/render/src",
  "projectType": "library",
  "tags": ["type:render", "scope:shared", "runtime:universal"],
  "implicitDependencies": ["domain"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/render/src", "cwd": "{workspaceRoot}" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/render/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.ts --passWithNoTests libs/render",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
