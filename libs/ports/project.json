{
  "name": "ports",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ports/src",
  "projectType": "library",
  "tags": ["type:port", "scope:shared", "runtime:universal"],
  "implicitDependencies": ["domain"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint libs/ports/src", "cwd": "{workspaceRoot}" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p libs/ports/tsconfig.json --noEmit", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.ts --passWithNoTests libs/ports",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
