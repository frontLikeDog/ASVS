{
  "name": "ai-software-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "nx serve web-studio",
    "dev:api": "nx serve api",
    "dev:stack": "nx run-many -t serve -p web-studio api --parallel=2",
    "github:verify": "nx run api:verify-github",
    "index:benchmark": "nx run api:index-benchmark",
    "build": "nx build web-studio",
    "budget": "node scripts/check-bundle-budget.mjs",
    "lint": "nx run-many -t lint",
    "lint:boundary-check": "node scripts/check-boundary-guard.mjs",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:e2e": "nx e2e web-studio",
    "render:fixture": "nx run render-worker:render-fixture",
    "render:fixture:build": "nx run render-worker:build-fixture",
    "verify:render": "node scripts/check-render-artifact.mjs",
    "capture:demo": "nx run browser-worker:capture-demo",
    "capture:repeat": "nx run browser-worker:repeat-capture",
    "capture:safety": "nx run browser-worker:safety-check",
    "capture:plan-digest": "nx run browser-worker:plan-digest",
    "verify:capture": "nx run browser-worker:verify-capture",
    "render:captured": "nx run render-worker:render-captured",
    "verify:render:captured": "node scripts/check-render-artifact.mjs --dir dist/render-worker/captured-30s",
    "validate": "nx run-many -t lint typecheck test",
    "validate:full": "node scripts/check-boundary-guard.mjs && nx run-many -t lint typecheck test",
    "graph": "nx graph"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "lucide-react": "1.73.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.18.5",
    "remotion": "4.0.545",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@nx/eslint-plugin": "22.7.12",
    "@playwright/test": "1.65.1",
    "@remotion/bundler": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "nx": "22.7.12",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.6",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
