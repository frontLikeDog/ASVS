# Optional GitHub App read-only connector (Step 4A)
# Copy this file to `apps/api/.env.local` (git-ignored) and fill in real values.
# NEVER commit `.env.local` or `.pem` private keys to git.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_DEFAULT_REPO=frontLikeDog/livenotes

# Narration / TTS (Step 5B). Optional; without it the API fails closed with 503
# when a run requests narration — it never substitutes a fake voice.
#   unconfigured        旁白不可用（默认，导出被拒绝，返回 503）
#   openai_compatible   真实 TTS 服务（需要 API_URL + API_KEY）
#   deterministic_test  离线测试音轨，明确标注 synthetic（非真人配音）
ASVS_TTS_PROVIDER=
ASVS_TTS_API_URL=
# 凭证严禁入库：只在本地 .env.local 或进程环境中设置，绝不提交。
ASVS_TTS_API_KEY=
ASVS_TTS_MODEL=tts-1
ASVS_TTS_VOICE_ZH=
ASVS_TTS_VOICE_EN=
ASVS_TTS_LICENSE=
ASVS_TTS_TIMEOUT_MS=30000
ASVS_TTS_MAX_RETRIES=3

# 独立 QA 与 AC-07 隐私守门（Step 5D）。默认值即下面的显式值；
# `qa_capture` / `qa_final` 是 DAG 的必过步骤，未配置 OCR 时按 fail-closed 阻断，
# 绝不把「没扫过」写成「通过」。
ASVS_QA_ENABLED=true
#   tesseract_cli       实际运行 Tesseract CLI（默认；二进制不存在时该次 QA fail-closed）
#   deterministic_test  离线确定性适配器：只做结构校验，报告里明确标注 ocrSynthetic
#   unconfigured        图像扫描一律 fail-closed（存在真实帧/截图时直接阻断）
ASVS_QA_OCR_PROVIDER=tesseract_cli
ASVS_QA_TESSERACT_BIN=tesseract
# 邮箱 / token / API Key / JWT / 卡号均为 ASCII，eng 更快更准。
ASVS_QA_OCR_LANG=eng
ASVS_QA_OCR_TIMEOUT_MS=15000
ASVS_QA_MAX_FRAMES=40
ASVS_QA_BLACK_BLOCK_MS=1000
ASVS_QA_FREEZE_BLOCK_MS=6000
# 逗号分隔的显式豁免域名（仅测试邮箱后缀）；留空 = 零豁免。
ASVS_QA_PRIVACY_ALLOWLIST_DOMAINS=
ASVS_QA_FFMPEG_BIN=ffmpeg
ASVS_QA_FFPROBE_BIN=ffprobe
ASVS_QA_MAX_TRACE_FRAMES=12
