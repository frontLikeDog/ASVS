{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["type:app", "type:api", "scope:api", "runtime:node"],
  "implicitDependencies": ["domain", "ports"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/api/src", "cwd": "{workspaceRoot}" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/api/tsconfig.json --noEmit", "cwd": "{workspaceRoot}" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.ts --passWithNoTests apps/api",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "tsx watch src/main.ts", "cwd": "apps/api" }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx src/main.ts", "cwd": "apps/api" },
      "cache": false
    },
    "verify-github": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx src/scripts/verify-github-readonly.ts", "cwd": "apps/api" },
      "cache": false
    },
    "index-benchmark": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx src/scripts/knowledge-index-benchmark.ts", "cwd": "apps/api" },
      "cache": false
    },
    "verify-discovery": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx src/scripts/verify-pr-discovery.ts", "cwd": "apps/api" },
      "cache": false
    },
    "verify-orchestration": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx src/scripts/verify-orchestration.ts", "cwd": "apps/api" },
      "cache": false
    },
    "verify-audio-export": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx src/scripts/verify-audio-export.ts", "cwd": "apps/api" },
      "cache": false
    }
  }
}
